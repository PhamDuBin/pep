# Coverage configuration for app package.
# Run: pytest -m "not integration" --cov=app --cov-report=term-missing [--cov-fail-under=80]

[run]
source = app
omit =
    app/__init__.py
    */tests/*

[report]
fail_under = 80
show_missing = true
exclude_lines =
    pragma: no cover
    def __repr__
    raise NotImplementedError
